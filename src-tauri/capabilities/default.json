{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "windows": ["*"],
  "webviews": ["*"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-toggle-maximize",
    "allow-tab-open",
    "allow-tab-show",
    "allow-tab-close",
    "allow-tab-nav",
    "allow-set-sidebar",
    "allow-tab-eval",
    "allow-tab-devtools",
    "allow-autofill-show",
    "allow-autofill-select",
    "allow-autofill-dismiss",
    "allow-new-window",
    "allow-set-top-bar",
    "allow-glance-open",
    "allow-glance-close",
    "allow-set-glance-bounds",
    "allow-request-glance",
    "allow-tab-focused",
    "allow-win-close",
    "allow-win-minimize",
    "allow-win-maximize",
    "allow-win-drag",
    "allow-open-download-file",
    "allow-show-download-folder",
    "allow-clear-profile-data",
    "allow-tab-zoom-changed",
    "allow-open-popup-window",
    "allow-close-popup-window",
    "allow-oauth-popup-post-message",
    "allow-oauth-popup-navigate-opener",
    "allow-show-context-menu"
  ]
}
