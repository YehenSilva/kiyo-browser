{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "autofill-remote",
  "windows": ["*"],
  "webviews": ["tab-*", "oauth-*"],
  "remote": {
    "urls": [
      "https://*/*",
      "http://localhost/*",
      "http://localhost:*/*",
      "http://127.0.0.1/*",
      "http://127.0.0.1:*/*"
    ]
  },
  "permissions": [
    "core:default",
    "core:event:default",
    "allow-autofill-field",
    "allow-autofill-select",
    "allow-autofill-dismiss",
    "allow-request-glance",
    "allow-tab-focused",
    "allow-tab-devtools",
    "allow-open-popup-window",
    "allow-close-popup-window",
    "allow-oauth-popup-post-message",
    "allow-oauth-popup-navigate-opener",
    "allow-tab-zoom-changed"
  ]
}
